{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "no-unused-vars": "warn"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "coverage/**", "scripts/**", "worker/vendor/**"]
}
