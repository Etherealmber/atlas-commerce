# v257 — Workers Assets cache policy (repeat visits & cold edge loads).
# Hashed bundles never change content -> cache forever; SPA html revalidates.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
