{
  "name": "atlas-commerce",
  "private": true,
  "version": "0.5.2-beta",
  "type": "module",
  "description": "Atlas Commerce — stock, devis, factures (web + Capacitor Android)",
  "author": "loxdpsy",
  "scripts": {
    "smoke": "node scripts/smoke-all.mjs",
    "smoke:risk": "node scripts/smoke-client-risk.mjs",
    "smoke:invoice": "node scripts/smoke-invoice-kinds.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "cap:sync": "npm run build && npx --yes @capacitor/cli sync android",
    "cap:open": "npx --yes @capacitor/cli open android",
    "cap:add": "npm run build && npx --yes @capacitor/cli add android",
    "cap:copy": "npx --yes @capacitor/cli copy android",
    "smoke:local": "ATLAS_SMOKE_BASE=http://127.0.0.1:8787 node scripts/smoke-all.mjs",
    "smoke:prod": "ATLAS_SMOKE_BASE=https://stock.afmarbre.com node scripts/smoke-all.mjs",
    "smoke:partner": "node scripts/smoke-partner-v1.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.4.2",
    "@hugeicons/core-free-icons": "^1.0.0",
    "@hugeicons/react": "^1.0.0",
    "hono": "^4.13.11",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.12",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^2.2.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gifenc": "^1.0.3",
    "puppeteer-core": "^25.15.0",
    "typescript": "^5.7.0",
    "upng-js": "^2.1.0",
    "vite": "^6.4.5",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "^5.20261005.1"
  }
}
