{
  "name": "atlas-commerce",
  "private": true,
  "version": "0.9.3-beta",
  "type": "module",
  "description": "Atlas Commerce — stock, devis, factures (web + Capacitor Android)",
  "author": "Etherealmber",
  "scripts": {
    "i18n:missing": "node scripts/i18n-missing.mjs",
    "smoke": "node scripts/smoke-all.mjs",
    "smoke:risk": "node scripts/smoke-client-risk.mjs",
    "smoke:invoice": "node scripts/smoke-invoice-kinds.mjs",
    "dev": "vite",
    "prepare:rust-wasm": "node scripts/ensure-rust-wasm-toolchain.mjs --install",
    "build:finance-wasm": "node scripts/build-finance-wasm.mjs --strict",
    "verify:worker-bundle": "node scripts/verify-worker-bundle.mjs",
    "build": "npm run build:finance-wasm && vite build && npm run verify:worker-bundle",
    "gen:demo-migrations": "node scripts/gen-demo-migrations.mjs",
    "build:cf": "npm run prepare:rust-wasm && npm run build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "smoke:local": "ATLAS_SMOKE_BASE=http://127.0.0.1:8787 node scripts/smoke-all.mjs",
    "smoke:prod": "ATLAS_SMOKE_BASE=https://stock.afmarbre.com node scripts/smoke-all.mjs",
    "smoke:partner": "node scripts/smoke-partner-v1.mjs",
    "smoke:offline": "node scripts/smoke-offline-operations.mjs",
    "smoke:cash-shifts": "node scripts/smoke-cash-shifts.mjs",
    "smoke:attendance": "node scripts/smoke-attendance.mjs",
    "smoke:payroll": "node scripts/smoke-payroll.mjs",
    "smoke:fec": "node scripts/smoke-fec.mjs",
    "smoke:dunning": "node scripts/smoke-dunning.mjs",
    "smoke:dgi": "node scripts/smoke-dgi.mjs",
    "test": "vitest run",
    "test:finance-wasm": "ATLAS_REQUIRE_WASM=1 vitest run worker/__tests__/finance-core-wasm.test.ts",
    "lint": "oxlint -c .oxlintrc.json src worker",
    "lint:fix": "oxlint -c .oxlintrc.json src worker --fix",
    "check:version": "node scripts/check-version-sync.mjs"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@hugeicons/core-free-icons": "^1.0.0",
    "@hugeicons/react": "^1.0.0",
    "@jsquash/webp": "^1.5.0",
    "exifr": "^7.1.3",
    "hono": "^4.13.16",
    "image-size": "^2.1.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^25.15.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "undici": "7.30.1"
  },
  "license": "MIT OR Apache-2.0"
}
