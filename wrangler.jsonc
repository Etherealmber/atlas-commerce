{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-stock",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // v257 — Smart Placement: this Worker is D1/KV/DO-round-trip heavy (every
  // API request runs several queries against a single-region D1 primary) while
  // all users sit in one country. Running the isolate next to those backends
  // removes one cross-region RTT per query. Declared here (not only in the
  // dashboard) so git-triggered Workers Builds keep it. Revert = delete block.
  "placement": {
    "mode": "smart"
  },
  // v254 — finance reminders run daily at 07:35 UTC ≈ 08:35 Africa/Casablanca.
  // The job is idempotent (durable outbox + UNIQUE idem keys), so a missed or
  // duplicated trigger never re-notifies. POST /api/cron/finance-reminders
  // (CRON_SECRET) remains available for external schedulers.
  "triggers": {
    "crons": ["35 7 * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // true = Worker always runs first (compatible with Wrangler 3 and 4).
    // Combined with the explicit fetch() handler that forces /api/* through Hono,
    // this prevents the SPA from answering API routes with HTML.
    "run_worker_first": true
  },
  // Resource IDs are not auth credentials — access still requires your CF account.
  // Sensitive values (passwords, API keys, emails) go in Secrets, NOT here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "company-stock-db",
      "database_id": "aba10fd7-bb8b-432c-a5ec-1701e43654c6",
      "preview_database_id": "local-company-stock-db",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "33a5cd31362243138590c446614ffb9b",
      "preview_id": "local-company-stock-cache"
    }
  ],
  // Optional Workers AI (vision OCR for /api/bills/parse-document and
  // /api/employees/parse-id): routes use env.AI when present and degrade
  // gracefully when absent. To enable, uncomment and redeploy:
  // "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "company-stock-images",
      "preview_bucket_name": "company-stock-images-preview"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "admin@afmarbre.com" // OTP_TO must match this; security@ is FROM only
    }
  ],
  // Public / non-secret config only. Everything sensitive → `wrangler secret put`
  "vars": {
    "ENVIRONMENT": "production",
    "CACHE_TTL_SECONDS": "300",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEco33YS31FvWems",
    // v259 — WebAuthn/passkeys capability config (non-secret). Hardened
    // verifier (worker/lib/webauthn.ts) deployed & reviewed (168 tests dont
    // la matrice WebAuthn). v0.7 : feature ON en prod sur ordre du
    // propriétaire (26 oct. 2026) — Android Credential Manager via
    // WEBAUTHN_ANDROID_PACKAGE + WEBAUTHN_ANDROID_CERT_HASH (SHA-256 de la
    // clé Play App Signing, docs/webauthn.md). Rollback immédiat : "false".
    "WEBAUTHN_ENABLED": "true",
    "WEBAUTHN_RP_ID": "stock.afmarbre.com",
    "WEBAUTHN_RP_NAME": "Atlas Commerce",
    "WEBAUTHN_ALLOWED_ORIGINS": "https://stock.afmarbre.com",
    "WEBAUTHN_REQUIRE_UV": "required",
    // Android Credential Manager: package is the Play applicationId. The cert
    // hash is the SHA-256 fingerprint of the PLAY APP SIGNING key (Play Console
    // → Setup → App integrity). Until it is filled in, assetlinks stays 404 and
    // native android:apk-key-hash-sha256 origins are NOT accepted — passkeys
    // remain web-origin only. See docs/webauthn.md §4.
    "WEBAUTHN_ANDROID_PACKAGE": "ma.etherealmber.atlascommerce",
    "WEBAUTHN_ANDROID_CERT_HASH": "53:D0:74:2C:A3:34:22:36:58:E1:D7:F8:8C:DC:67:C5:4D:B0:AC:4E:17:88:59:DA:13:2D:4A:9F:30:62:65:6E,FC:CC:F6:C3:B2:3D:B8:BE:1D:74:AF:BE:D5:04:DA:EA:5F:5D:FF:AF:8C:6F:C4:5A:F8:F0:2B:6A:C8:87:6C:C1",
    // Optional SHA-1 fingerprint of the SAME signing certificate — enables the
    // legacy `android:apk-key-hash:` origin format (base64 of SHA-1) documented
    // by Android's FIDO2 stack. Both formats are accepted byte-for-byte.
    "WEBAUTHN_ANDROID_CERT_SHA1": ""
  },

  // Required by `wrangler preview` (Workers Builds deploy command).
  // Mirrors the production bindings above so preview deployments run with the
  // same resources; only ENVIRONMENT differs. Durable Objects are intentionally
  // omitted here — wrangler excludes them from previews (warning only).
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "CACHE_TTL_SECONDS": "300",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAEco33YS31FvWems"
    },
    "kv_namespaces": [
      {
        "binding": "CACHE",
        "id": "33a5cd31362243138590c446614ffb9b"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "company-stock-db",
        "database_id": "aba10fd7-bb8b-432c-a5ec-1701e43654c6"
      }
    ],
    "r2_buckets": [
      {
        "binding": "IMAGES",
        "bucket_name": "company-stock-images"
      }
    ],
    "send_email": [
      {
        "name": "EMAIL",
        "destination_address": "admin@afmarbre.com"
      }
    ]
  },


  // Free-tier SQLite Durable Objects (100k req/day)
  "durable_objects": {
    "bindings": [
      {
        "name": "MOBILE_HUB",
        "class_name": "MobileHub"
      },
      {
        "name": "RESTORE_HUB",
        "class_name": "RestoreHub"
      },
      {
        "name": "NUMBER_HUB",
        "class_name": "NumberHub"
      },
      {
        "name": "AGENT_QUOTA_HUB",
        "class_name": "AgentQuotaHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-mobile-hub",
      "new_sqlite_classes": ["MobileHub"]
    },
    {
      "tag": "v2-restore-hub",
      "new_sqlite_classes": ["RestoreHub"]
    },
    {
      "tag": "v3-number-hub",
      "new_sqlite_classes": ["NumberHub"]
    },
    {
      "tag": "v4-agent-quota-hub",
      "new_sqlite_classes": ["AgentQuotaHub"]
    }
  ],
  // Workers Logs + Traces (dashboard Observability toggles also work after deploy)
  
  // Optional: Cloudflare Queues for async jobs (create queue in dashboard, then uncomment)
  // "queues": {
  //   "producers": [{ "binding": "QUEUE", "queue": "atlas-jobs" }],
  //   "consumers": [{ "queue": "atlas-jobs", "max_batch_size": 10, "max_retries": 3 }]
  // },
  // CDN: Workers Assets + R2 custom domain (CDN_BASE secret). Anycast LB is automatic on Cloudflare.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }

}
